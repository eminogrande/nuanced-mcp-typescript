{
  "name": "nuanced-typescript",
  "version": "0.2.0",
  "description": "MCP server exposing nuanced call-graph analysis for Python and TypeScript",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "nuanced-mcp-ts": "dist/index.js",
    "nuanced-brain": "dist/brain-cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --test dist/test/*.test.js && node dist/test/mcp-selfcheck.js",
    "brain": "node dist/brain-cli.js",
    "benchmark": "npm run build --silent && node dist/brain-cli.js benchmark",
    "benchmark:public": "npm run build --silent && node --test dist/test/benchmark.test.js",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "ts-morph": "^25.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
